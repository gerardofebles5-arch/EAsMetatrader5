; MoneyMachine7 - MachinePRO EXACT REPLICA (CORREGIDO)
; Nombres de parámetros compatibles con .set original
; Fecha: 2026-03-05
; Correcciones aplicadas según análisis de Claude

;=================================================================
; CORE SETTINGS
;=================================================================
Magic_Number=700000
CommentOrder=MoneyMachine7
Control_orders_user=true

;=================================================================
; SMC STRATEGY
;=================================================================
InpStrategy=1
FVG_Lookback_Bars=1200
Min_FVG_Size_Points=10.0
Draw_FVG_Zones=true
OB_Lookback_Bars=1200
OB_Min_Body_Percent=50.0
Draw_OB_Zones=true

;=================================================================
; GRID SYSTEM
;=================================================================
Grid_Intensity=3
ADR_Period_Days=1
Grid_Distance_Multiplier=1.0
Custom_ADR_Divider=1000.0
Max_Buy=100
Max_Sell=100
Use_Grid_Stoch_Filter=true
Stoch_Buy_Level=30.0
Stoch_Sell_Level=70.0
Stoch_K_Period=14
Stoch_D_Period=3
Stoch_Slowing=3
Order_dynamic_distance=4
Distance_multiplier=1.0

;=================================================================
; BREAKOUT STRATEGY
;=================================================================
Enable_Breakout_Strategy=true
Breakout_Period=50
Breakout_Buffer=120.0
Min_Breakout_Range=300.0
Use_RSI_Confirmation=true
RSI_Period=14
RSI_Buy_Threshold=66.0
RSI_Sell_Threshold=44.0
Use_Volume_Confirmation=true
Volume_Ma_Period=10

;=================================================================
; STOP HUNT STRATEGY
;=================================================================
Enable_Stop_Hunt_Strategy=true
Swing_Lookback=50
Hunt_Confirmation_Points=5.0

;=================================================================
; LOT SIZING
;=================================================================
Lot=0.1
Use_dynamic_lot=true
Free_margin_for_each_Lots=1000.0
Max_Lot=5.0
Kmartin=1.0

;=================================================================
; TP/SL
;=================================================================
Use_Auto_TP=true
Auto_TP_Ratio=5.0
Use_Auto_SL=true
Auto_SL_Ratio=1.5
ATR_Period=7
Use_Stealth_Mode=true

;=================================================================
; TRAILING STOP
;=================================================================
Enable_TrailingStop=true
TS_Start_ATR_Multiplier=5.0
TS_Distance_ATR_Multiplier=5.0

;=================================================================
; BREAKEVEN
;=================================================================
Enable_Breakeven=false
BE_Trigger_ATR_Multiplier=1.0
BE_Profit_Points=10

;=================================================================
; FILTERS
;=================================================================
Enable_Trend_Filter=true
Trend_MA_Period=200
Use_News_Filter=true
News_Suspend_Mins_Before=30
News_Suspend_Mins_After=30
Use_Gold_Session_Filter=false
InpMaxSpreadPoints=10000
InpSlippagePoints=10

;=================================================================
; RECOVERY MODE
;=================================================================
Recovery_Mode_Enabled=true
Recovery_Target_USD=2.0
Overlap_AFTER_X_trades=4

;=================================================================
; BASKET MANAGEMENT
;=================================================================
Basket_Profit_USD=0.0
Basket_Loss_USD=0.0

;=================================================================
; RISK MANAGEMENT
;=================================================================
Daily_Loss_Limit_USD=500000.0
InpMaxDailyLossPct=50.0
InpMaxEquityDrawdown=50.0
Max_Drawdown_Percent=90.0
Daily_Profit_Target_USD=1000000.0
Stop_After_Losses=0

;=================================================================
; TRADING SCHEDULE
;=================================================================
Monday_Active=true
Monday_Start_Hour=5
Monday_End_Hour=21
Tuesday_Active=true
Tuesday_Start_Hour=5
Tuesday_End_Hour=21
Wednesday_Active=true
Wednesday_Start_Hour=5
Wednesday_End_Hour=21
Thursday_Active=true
Thursday_Start_Hour=5
Thursday_End_Hour=21
Friday_Active=true
Friday_Start_Hour=5
Friday_End_Hour=18
Saturday_Active=false
Sunday_Active=false

;=================================================================
; DISPLAY
;=================================================================
Enable_History_Labels=true
History_Labels_Limit=50
Enable_Dashboard=true
Dashboard_Corner=0
Dashboard_X_Position=10
Dashboard_Y_Position=30
Refresh_Interval_Seconds=1
Font_size_Result=11
